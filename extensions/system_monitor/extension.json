{
  "id": "system_monitor",
  "name": "System Monitor",
  "icon": "monitor",
  "description": "CPU, RAM, GPU, disk and system processes",
  "platforms": ["windows", "linux"],
  "version": "1.1",
  "author": "SentinelGD",
  "category": "system",
  "refresh_interval": 2000,
  "realtime": true,
  "css_modules": ["style.css"],

  "grid_size": { "w": 2, "h": 2 },
  "widgets": [
    { "id": "cpu", "type": "chart", "label": "CPU", "action": "get_cpu" },
    { "id": "ram", "type": "chart", "label": "RAM", "action": "get_ram" },
    { "id": "gpu", "type": "chart", "label": "GPU", "action": "get_gpu" },
    { "id": "disk", "type": "chart", "label": "DISK", "action": "get_disk" }
  ]
}
