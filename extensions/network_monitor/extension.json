{
  "id": "network_monitor",
  "name": "Network Monitor",
  "icon": "network",
  "description": "Public IP, VPN, ports, DNS leaks",
  "version": "1.4",
  "author": "Arnau",
  "category": "cybersecurity",
  "realtime": true,
  "refresh_interval": 5000,
  "js_modules": ["script.js"],
  "css_modules": ["style.css"],
  "menu_items": [],
  "grid_size": { "w": 2, "h": 2 },
  "widgets": [
    { "id": "public_ip", "type": "text", "label": "Public IP", "action": "get_ip" },
    { "id": "vpn_status", "type": "badge", "label": "VPN", "action": "check_vpn", "click_action": "vpn_control" },
    { "id": "open_ports", "type": "list", "label": "Open Ports", "action": "get_open_ports", "click_action": "show_ports_panel" }
  ]
}
